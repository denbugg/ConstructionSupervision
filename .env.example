# ─── Общее ────────────────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO
TZ=Europe/Moscow
API_KEY=dev-key-change-me
RUN_MIGRATIONS=true
# Внешний порт gateway (интерфейс, API, сводный Swagger)
GATEWAY_PORT=8080
# Куда смонтирован packages/contracts: классы техники и перечисления (только чтение)
CONTRACTS_DIR=/contracts
# Необязательные сервисы compose: llm — локальная Gemma для резюме отчётов (раздел LLM ниже).
# Пусто — без неё: резюме пишет облачная модель из LLM_* или шаблон.
COMPOSE_PROFILES=llm

# ─── Образы ───────────────────────────────────────────────────────────────────
# Откуда брать образы вместо локальной сборки: make pull тянет их из ghcr,
# собранные CI. Полезно на демо-ноутбуке: образ с CUDA собирается десятки минут,
# а скачивается единицы. IMAGE_TAG: latest — последний релиз, v0.x.y — конкретный,
# main — последний зелёный коммит main (runbook, раздел 10).
IMAGE_REGISTRY=ghcr.io/cerxxxx/constructionsupervision
IMAGE_TAG=latest

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Пароль роли сервиса записан дважды: в *_DB_PASSWORD (им база создаёт роль при первом
# запуске) и внутри *_DB_DSN (им подключается сервис). Меняются только вместе.
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=postgres-change-me

PLAN_DB_PASSWORD=plan-change-me
SITE_DB_PASSWORD=site-change-me
ANALYSIS_DB_PASSWORD=analysis-change-me

PLAN_DB_DSN=postgresql+asyncpg://plan_user:plan-change-me@postgres:5432/plandb
SITE_DB_DSN=postgresql+asyncpg://site_user:site-change-me@postgres:5432/sitedb
ANALYSIS_DB_DSN=postgresql+asyncpg://analysis_user:analysis-change-me@postgres:5432/analysisdb

# ─── Объектное хранилище и очередь ────────────────────────────────────────────
S3_ENDPOINT=http://s3:8333
# Путь, под которым gateway отдаёт хранилище браузеру (ADR-0017). Ссылки на снимки и отчёты
# приходят без хоста и открываются с любого адреса стенда: localhost, локальная сеть, туннель.
S3_PUBLIC_PATH=/storage
# Те же ключи — вход в веб-интерфейс SeaweedFS (http://localhost:23646)
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3admin-change-me
S3_BUCKET_IMAGES=images
S3_BUCKET_REPORTS=reports
S3_PRESIGN_TTL_S=3600
REDIS_URL=redis://redis:6379/0

# ─── Адреса сервисов ──────────────────────────────────────────────────────────
PLAN_URL=http://plan-service:8000
SITE_URL=http://site-service:8000
ANALYSIS_URL=http://analysis-service:8000
VISION_URL=http://vision-service:8000

# ─── Компьютерное зрение ──────────────────────────────────────────────────────
# Без оверлея docker-compose.gpu.yml карта в контейнер не пробрасывается, и cuda
# молча становится cpu (видно в GET /api/v1/vision/model).
VISION_DEVICE=cuda
# Дообученный детектор демо-стенда (fetch_models.py, группа demo). Zero-shot —
# /models/yolov8s-worldv2.pt: технику на кадрах Лимы он почти не узнаёт (docs/metrics.md).
# Смена весов действует на новые снимки; уже распознанные пересчитывает
# POST /api/v1/site/images/reanalyze.
VISION_DET_WEIGHTS=/models/yolov8s-worldv2-ce-ulima-v1.pt
VISION_DET_CONF=0.35
VISION_DET_IOU=0.5
VISION_DET_IMGSZ=1280
VISION_STAGE_ENABLED=true
VISION_STAGE_MODEL=openclip-vit-b32
VISION_MAX_MB=20
# Колёса PyTorch при сборке образа: cu128 — GPU, https://download.pytorch.org/whl/cpu — образ
# без CUDA, в разы легче.
VISION_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

# ─── Конвейер и методика ──────────────────────────────────────────────────────
SESSION_WINDOW_MINUTES=30
# Пояс часов камер: время из EXIF и имени файла без смещения считается местным для него
CAMERA_TIMEZONE=Europe/Moscow
MAX_IMAGE_MB=20
WORKER_CONCURRENCY=4
# Проход site-worker по базе: снимки, потерянные очередью или отложенные из-за недоступного
# vision, ставятся заново. Интервал делит минуту нацело.
SWEEP_INTERVAL_S=30
STALE_PROCESSING_MINUTES=10
# Предел задачи site-worker «пересчитать факты всех окон объекта после правки зон»
REAPPLY_TIMEOUT_S=600
VISION_TIMEOUT_S=30
MOVE_THRESHOLD=0.01
MIN_BRIGHTNESS=0.15
MAX_BLUR=0.6
TRANSIENT_WINDOW_SESSIONS=4
MIN_STAGE_CONF=0.5
MIN_ACTIVITY=0.1
FORECAST_WINDOW_DAYS=5
MIN_DAYS_FOR_FORECAST=3
ON_TRACK_TOLERANCE_DAYS=2
CONFIDENCE_HIGH_DAYS=5
CONFIDENCE_HIGH_VISIBLE=0.8
CONFIDENCE_MEDIUM_VISIBLE=0.5
UNKNOWN_BLIND_SHARE=0.5
RUN_STALE_AFTER_S=900
RUN_WAIT_TIMEOUT_S=120
EXPLAIN_MAX_SESSIONS=64

# ─── LLM: резюме отчёта (ADR-0008) ────────────────────────────────────────────
# Любой OpenAI-совместимый API: локальный сервер или облачный провайдер. Модель получает только
# готовые факты и пишет по ним текст; нет ответа за LLM_TIMEOUT_S — резюме по шаблону.
# По умолчанию — сервис llm из compose (Gemma 4 E4B, профиль llm выше). Другие варианты:
#   свой сервер на хосте (llama.cpp, Ollama, LM Studio):
#     LLM_BASE_URL=http://host.docker.internal:11434/v1   LLM_MODEL=<имя модели на сервере>
#   облачный API (OpenAI, OpenRouter, шлюз к GigaChat / YandexGPT):
#     LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini   LLM_API_KEY=<ключ>
#   без модели: LLM_ENABLED=false — резюме по шаблону.
# Для своего сервера или облака уберите llm из COMPOSE_PROFILES, чтобы не держать Gemma в памяти.
LLM_ENABLED=true
LLM_BASE_URL=http://llm:8080/v1
LLM_API_KEY=
LLM_MODEL=gemma-4-e4b
# Gemma на видеокарте пишет резюме за 3–5 с, на процессоре — около 50 с. Больше 100 не ставить:
# gateway ждёт ответа сервиса 120 с, а отчёту нужно ещё время на PDF.
LLM_TIMEOUT_S=100
