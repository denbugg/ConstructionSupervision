# ─── Общее ────────────────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO
TZ=Europe/Moscow
API_KEY=dev-key-change-me
RUN_MIGRATIONS=true
# Внешний порт gateway (интерфейс, API, сводный Swagger)
GATEWAY_PORT=8080
# Куда смонтирован packages/contracts: классы техники и перечисления (только чтение)
CONTRACTS_DIR=/contracts

# ─── Образы ───────────────────────────────────────────────────────────────────
# Откуда брать образы вместо локальной сборки: make pull тянет их из ghcr,
# собранные workflow Release. Полезно на демо-ноутбуке: образ с CUDA
# собирается десятки минут, а скачивается единицы.
IMAGE_REGISTRY=ghcr.io/cerxxxx/constructionsupervision
IMAGE_TAG=latest

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=postgres-change-me

PLAN_DB_PASSWORD=plan-change-me
SITE_DB_PASSWORD=site-change-me
ANALYSIS_DB_PASSWORD=analysis-change-me

PLAN_DB_DSN=postgresql+asyncpg://plan_user:plan-change-me@postgres:5432/plandb
SITE_DB_DSN=postgresql+asyncpg://site_user:site-change-me@postgres:5432/sitedb
ANALYSIS_DB_DSN=postgresql+asyncpg://analysis_user:analysis-change-me@postgres:5432/analysisdb

# ─── Объектное хранилище и очередь ────────────────────────────────────────────
S3_ENDPOINT=http://s3:8333
# Адрес хранилища для браузера: подпись ссылки привязана к адресу, s3:8333 браузер не откроет
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Те же ключи — вход в веб-интерфейс SeaweedFS (http://localhost:23646)
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3admin-change-me
S3_BUCKET_IMAGES=images
S3_BUCKET_REPORTS=reports
S3_PRESIGN_TTL_S=3600
REDIS_URL=redis://redis:6379/0

# ─── Адреса сервисов ──────────────────────────────────────────────────────────
PLAN_URL=http://plan-service:8000
SITE_URL=http://site-service:8000
ANALYSIS_URL=http://analysis-service:8000
VISION_URL=http://vision-service:8000

# ─── Компьютерное зрение ──────────────────────────────────────────────────────
# Без оверлея docker-compose.gpu.yml карта в контейнер не пробрасывается, и cuda
# молча становится cpu (видно в GET /api/v1/vision/model).
VISION_DEVICE=cuda
VISION_DET_WEIGHTS=/models/yolov8s-worldv2.pt
VISION_DET_CONF=0.35
VISION_DET_IOU=0.5
VISION_DET_IMGSZ=1280
VISION_STAGE_ENABLED=true
VISION_STAGE_MODEL=openclip-vit-b32
VISION_MAX_MB=20
# Колёса PyTorch при сборке образа: cu128 — GPU, https://download.pytorch.org/whl/cpu — образ
# без CUDA, в разы легче.
VISION_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

# ─── Конвейер и методика ──────────────────────────────────────────────────────
SESSION_WINDOW_MINUTES=30
# Пояс часов камер: время из EXIF и имени файла без смещения считается местным для него
CAMERA_TIMEZONE=Europe/Moscow
MAX_IMAGE_MB=20
WORKER_CONCURRENCY=4
# Проход site-worker по базе: снимки, потерянные очередью или отложенные из-за недоступного
# vision, ставятся заново. Интервал делит минуту нацело.
SWEEP_INTERVAL_S=30
STALE_PROCESSING_MINUTES=10
# Предел задачи site-worker «пересчитать факты всех окон объекта после правки зон»
REAPPLY_TIMEOUT_S=600
VISION_TIMEOUT_S=30
MOVE_THRESHOLD=0.01
MIN_BRIGHTNESS=0.15
MAX_BLUR=0.6
TRANSIENT_WINDOW_SESSIONS=4
MIN_STAGE_CONF=0.5
MIN_ACTIVITY=0.1
FORECAST_WINDOW_DAYS=5
MIN_DAYS_FOR_FORECAST=3
ON_TRACK_TOLERANCE_DAYS=2
CONFIDENCE_HIGH_DAYS=5
CONFIDENCE_HIGH_VISIBLE=0.8
CONFIDENCE_MEDIUM_VISIBLE=0.5
UNKNOWN_BLIND_SHARE=0.5
RUN_STALE_AFTER_S=900
RUN_WAIT_TIMEOUT_S=120
EXPLAIN_MAX_SESSIONS=64

# ─── LLM: резюме отчёта (ADR-0008) ────────────────────────────────────────────
# Любой OpenAI-совместимый API: облачный провайдер (GigaChat, YandexGPT через совместимый
# шлюз) или локальный сервер. Пустой LLM_BASE_URL — резюме по шаблону.
# Локально (runbook, раздел 4): llama-server на хосте, контейнер ходит на host.docker.internal:
#   LLM_BASE_URL=http://host.docker.internal:8091/v1   LLM_MODEL=gemma-4-e4b   LLM_TIMEOUT_S=60
LLM_ENABLED=true
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=30
